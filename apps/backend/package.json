{
    "name": "@grindcord/backend",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/types.d.ts",
    "exports": {
        "./types": "./dist/types.d.ts",
        "./characters": "./dist/characters.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build:app": "swc src -d dist --strip-leading-paths",
        "build:types": "tsc --emitDeclarationOnly",
        "build": "pnpm build:app && pnpm build:types",
        "start": "node dist/index.js",
        "test": "vitest --typecheck",
        "test:unit": "vitest unit",
        "check": "biome check"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.10",
        "@hono/standard-validator": "^0.2.2",
        "@hono/zod-validator": "^0.7.6",
        "@logtape/hono": "^1.3.7",
        "@logtape/logtape": "^1.3.7",
        "better-sqlite3": "^12.6.2",
        "hono": "^4.12.5",
        "hono-openapi": "^1.1.0",
        "knex": "^3.1.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.3.0"
    }
}
