{
    "compilerOptions": {
        "noEmit": false,
        "module": "NodeNext",
        "moduleResolution": "nodenext",

        "rootDir": "src",
        "outDir": "./dist",

        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "declaration": true,

        "types": ["node"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
    },
    "include": ["src/**/*.ts"],
    "exclude": ["vitest.config.ts", "dist", "node_modules"]
}
